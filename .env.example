# 站点根 URL（无尾部斜杠）。用于 canonical、RSS、sitemap、OG。
# Cloudflare Pages 请在「构建环境变量」中设置同名变量，不要依赖未提交的 .env。
SITE_URL=https://your-domain.com

# 子路径前缀。根域名或本地开发留空即可。
# GitHub Pages 示例：BASE_PATH=/my-blog
BASE_PATH=

# --- 作者 / 社交 ---
PUBLIC_GITHUB_HANDLE=
PUBLIC_GITHUB_REPO=
PUBLIC_CONTACT_EMAIL=

# --- Giscus ---
PUBLIC_GISCUS_ENABLED=false
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
