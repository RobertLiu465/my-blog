---
import { SITE } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { useTranslations, localizedPath } from '~/i18n/utils';
import { getPosts, getCategoriesWithCount } from '~/utils/posts';
import type { CategoryId } from '~/config/taxonomies';

interface Props {
  categoryId: CategoryId;
  categoryName: string;
  locale: (typeof SITE.locales)[number];
}

export async function getStaticPaths() {
  let paths = [];
  for (const locale of SITE.locales) {
    const categories = await getCategoriesWithCount(locale);
    const localeParams = { locale: locale === SITE.defaultLocale ? undefined : locale };
    paths.push(
      ...categories.map((c) => ({
        params: { ...localeParams, category: c.id },
        props: { categoryId: c.id, categoryName: c.name, locale },
      })),
    );
  }
  return paths;
}

const { categoryId, categoryName, locale } = Astro.props as Props;
const { category } = Astro.params;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).filter((p) => p.data.categories.includes(categoryId));
---

<BaseLayout
  title={categoryName}
  pathWithoutLocale={`/categories/${category}/`}
  crumbs={[
    { label: t('categories.title'), href: localizedPath('/categories/', locale) },
    { label: categoryName },
  ]}
>
  <header class="mb-6">
    <p class="text-base-content/70 text-sm tracking-wide uppercase">{t('list.categoryPosts')}</p>
    <h1 class="text-3xl font-bold tracking-tight">{categoryName}</h1>
    <p class="text-base-content/70 mt-1 text-sm">
      {posts.length}
      {posts.length === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
    </p>
  </header>
  <PostList posts={posts} locale={locale} />
</BaseLayout>
