---
/**
 * Twikoo 评论岛组件。三种状态：
 *   - live     → 加载 Twikoo 客户端
 *   - setup    → 已全局启用但未配置 envId
 *   - disabled → 文章或全局关闭评论
 *
 * 在 `src/config.ts` -> TWIKOO 或 PUBLIC_TWIKOO_* 环境变量中配置。
 */
import { TWIKOO, type Locale } from '../../config';
import { useTranslations } from '../../i18n/utils';
import { isTwikooEnvConfigured } from '../../utils/twikoo';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
  /** 用于区分不同文章的页面路径（含 BASE_PATH 前缀）。 */
  path: string;
  /** 单篇文章 frontmatter 覆盖；默认 true。 */
  enabled?: boolean;
}

const { locale, path, enabled = true } = Astro.props;
const t = useTranslations(locale);

const twikooGloballyEnabled = TWIKOO.enabled;
const twikooPostEnabled = enabled;

const twikooConfigured = isTwikooEnvConfigured(TWIKOO.envId);

type CommentState = 'live' | 'setup' | 'disabled';
const state: CommentState =
  !twikooGloballyEnabled || !twikooPostEnabled ? 'disabled' : twikooConfigured ? 'live' : 'setup';

function renderInlineCode(input: string): string {
  return input.replace(/`([^`]+)`/g, (_, code: string) => {
    const escaped = code.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
    return `<code class="rounded border border-base-300 bg-base-100 px-1.5 py-0.5 text-[0.8em] font-mono text-base-content">${escaped}</code>`;
  });
}

const setupSteps = [
  t('post.commentsTwikooSetupStep1'),
  t('post.commentsTwikooSetupStep2'),
  t('post.commentsTwikooSetupStep3'),
  t('post.commentsTwikooSetupStep4'),
];

const twikooLang = locale === 'zh-cn' ? 'zh-CN' : 'en';
---

<section class="border-base-300 mt-12 border-t pt-8" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="mb-4 text-xl font-semibold">{t('post.comments')}</h2>

  {
    state === 'live' && (
      <div
        id="tcomment"
        data-twikoo-mount
        data-env-id={TWIKOO.envId}
        data-path={path}
        data-region={TWIKOO.region}
        data-lang={twikooLang}
      />
    )
  }

  {
    state === 'setup' && (
      <div
        role="note"
        class="twikoo-setup border-base-300 bg-base-200/60 flex gap-4 rounded-lg border p-5 text-sm sm:p-6"
      >
        <div
          class="bg-info/15 text-info flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
          aria-hidden="true"
        >
          <Icon name="lucide:settings" width={18} height={18} />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-base-content text-base font-semibold">
            {t('post.commentsTwikooSetupTitle')}
          </p>
          <p class="text-base-content/70 mt-1">{t('post.commentsTwikooSetupBody')}</p>
          <ol class="text-base-content/80 marker:text-base-content/50 mt-4 list-decimal space-y-1.5 pl-5 marker:font-semibold">
            {setupSteps.map((step) => (
              <li set:html={renderInlineCode(step)} />
            ))}
          </ol>
          <p class="mt-4">
            <a
              href="https://twikoo.js.org"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:text-primary/80 inline-flex items-center gap-1 text-sm font-medium underline-offset-4 hover:underline"
            >
              {t('post.commentsTwikooSetupDocs')}
              <Icon name="lucide:arrow-up-right" width={14} height={14} />
            </a>
          </p>
        </div>
      </div>
    )
  }

  {
    state === 'disabled' && (
      <p class="text-base-content/70 text-sm italic">{t('post.commentsDisabled')}</p>
    )
  }
</section>

<script>
  const TWIKOO_CDN = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.11/dist/twikoo.min.js';

  function updateVisitorsCount(envId: string, path: string, region?: string) {
    const el = document.getElementById('twikoo_visitors');
    const twikoo = window.twikoo;
    if (!el || !twikoo?.getVisitorsCount) return;

    const options: Record<string, string> = { envId, path };
    if (region) options.region = region;

    void twikoo.getVisitorsCount(options).then((res) => {
      if (res && (res.time === 0 || res.time)) el.textContent = String(res.time);
    });
  }

  function mountTwikoo() {
    const mount = document.querySelector<HTMLElement>('[data-twikoo-mount]');
    if (!mount || mount.dataset.mounted === 'true') return;

    const envId = mount.dataset.envId;
    if (!envId) return;

    const runInit = () => {
      const twikoo = window.twikoo;
      if (!twikoo || typeof twikoo.init !== 'function') return;

      const options: Record<string, string> = {
        envId,
        el: '#tcomment',
        path: mount.dataset.path || location.pathname,
        lang: mount.dataset.lang || 'zh-CN',
      };

      const region = mount.dataset.region;
      if (region) options.region = region;

      const initResult = twikoo.init(options);
      mount.dataset.mounted = 'true';
      const refreshVisitors = () => updateVisitorsCount(envId, options.path, region);

      if (initResult && typeof (initResult as Promise<void>).then === 'function') {
        void (initResult as Promise<void>).then(refreshVisitors);
      } else {
        refreshVisitors();
      }
    };

    const existing = document.querySelector<HTMLScriptElement>(`script[src="${TWIKOO_CDN}"]`);
    if (existing) {
      if (window.twikoo) {
        runInit();
      } else {
        existing.addEventListener('load', runInit, { once: true });
      }
      return;
    }

    const script = document.createElement('script');
    script.src = TWIKOO_CDN;
    script.async = true;
    script.addEventListener('load', runInit, { once: true });
    document.head.appendChild(script);
  }

  mountTwikoo();
  document.addEventListener('astro:page-load', mountTwikoo);
</script>
