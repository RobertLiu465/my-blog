#!/usr/bin/env sh

echo ""
echo "================================================="
echo " ⏳ Running pre-commit formatting & linting..."
echo "================================================="

FORCE_COLOR=1 bunx lint-staged

if [ $? -ne 0 ]; then
  echo ""
  echo "================================================="
  echo " ❌ PRE-COMMIT FAILED"
  echo ""
  echo " 1. 查看上方 ESLint / Prettier 报错"
  echo " 2. 运行: bun run precommit"
  echo " 3. git add -u 后再次 commit"
  echo " 4. 仍失败则运行: bun run verify"
  echo "================================================="
  exit 1
fi
